<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.langchain4j</groupId>
        <artifactId>quarkus-langchain4j-agentic-viewer-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <!-- Dev-mode-only artifact: declared as a conditional dev dependency of the runtime module,
         so it is never part of a prod or native build -->
    <artifactId>quarkus-langchain4j-agentic-viewer-dev</artifactId>
    <name>Quarkus LangChain4j Agentic Viewer - Runtime Dev</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-agentic-viewer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Pattern adapters (patterns package) compile against it; applications add it themselves when they use the
             patterns, and the adapters are only registered (and loaded) when its classes are present. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-agentic-patterns</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
